PORT=5000

# Google Places API (New) - get from console.cloud.google.com
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Companies House API - free at developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key_here

# Bing Web Search API - optional, adds web search verification layer
BING_SEARCH_API_KEY=your_bing_search_api_key_here

# Cache TTL in seconds (default 1 hour)
CACHE_TTL=3600

# Max businesses to process per search (cost control)
MAX_BUSINESSES=50

# Request timeout in ms
REQUEST_TIMEOUT=8000
